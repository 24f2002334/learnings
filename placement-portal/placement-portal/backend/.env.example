# Copy this file to backend/.env and fill in real values.
# Flask/Celery pick these up automatically if you `pip install python-dotenv`
# and load them (see README for the exact command), or export them in your shell.

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Redis (used for both Flask-Caching and as the Celery broker/result backend)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Pre-existing admin bootstrap (used only by seed.py)
ADMIN_EMAIL=admin@placementportal.local
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Placement Cell Admin

# Google Chat incoming webhook — used for daily deadline reminders
# Create one via: Google Chat space > Apps & integrations > Webhooks
GCHAT_WEBHOOK_URL=

# SMTP — used for the monthly report and CSV export-ready emails
# For Gmail: enable 2FA then create an "App Password" to use as MAIL_PASSWORD
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Optional: tune when the daily reminder job fires and how far ahead it looks
REMINDER_HOUR=9
REMINDER_MINUTE=0
REMINDER_DAYS_AHEAD=3
